{
  "name": "multiplayer-cube-arena-example",
  "version": "1.0.0",
  "description": "Multiplayer cube arena: WASD-driven 3D cubes on a shared grid, prediction + interpolation via murow/netcode, rendered with murow/webgpu.",
  "type": "module",
  "private": true,
  "scripts": {
    "build:client": "vite build",
    "build": "bun run scripts/build.ts",
    "server": "bun run server/index.ts",
    "dev:client": "vite",
    "dev": "bun run build:client && bun run server"
  },
  "keywords": [
    "multiplayer",
    "webgpu",
    "prediction",
    "interpolation",
    "murow"
  ],
  "dependencies": {
    "murow": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.0.0",
    "unplugin-typegpu": "^0.10.2",
    "vite": "^5.0.0"
  }
}

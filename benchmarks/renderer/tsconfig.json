{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types"],
    "baseUrl": ".",
    "paths": {
      "murow": ["../../packages/murow/src/", "../../packages/murow/dist/types/"],
      "murow/webgpu": ["../../packages/webgpu/src/"],
      "murow/*": ["../../packages/murow/src/*", "../../packages/murow/dist/types/*"],
    }
  },
  "include": ["*.ts", "programs/**/*.ts"]
}
